# Copy to `.env` (git-ignored) at the thesis root:  cp env.example .env
#
# THESIS_LLM_CALLS gates every paid or external model call in the prototype:
# the Codex / Claude / agy CLI adapters, the UC-03 Google speech backends and
# the frozen translation stage. FALSE (the default when the variable is absent)
# makes every such call fail closed with a hint; the offline `mock` provider
# always works. Override per run with `--force-llm` on any dispatching CLI, or
# with the ON/OFF toggle in the demo frontend.
THESIS_LLM_CALLS=FALSE
