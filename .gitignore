substrate/snapshots/intermediate/stage2-comet*
substrate/snapshots/intermediate/comet-gpu-run/

# The built database: assembled from the committed snapshots by build_all (the Instalace screen), never shipped
substrate/snapshots/substrate.db

# Compressed transport (substrate/pipeline/packing.py): git ships the .gz, code reads the plain .json
substrate/snapshots/amazon/amazon-original-en.json
substrate/snapshots/amazon/amazon-translated-cz.json
substrate/snapshots/amazon/amazon-catalog-en.json
substrate/snapshots/provenance/translation/stage1-translate.json
substrate/snapshots/provenance/pre-clean-2026-09-02/uc01-contacts-english-mapped-snapshot.json
# Regenerable layers (build_all rebuilds them from the pinned downloads) and the downloads themselves
substrate/snapshots/intermediate/
substrate/pipeline/data_acquisition/stratified_500_users.json
substrate/pipeline/data_acquisition/downloaded/


# Run folders are the provenance of the numbers in the thesis and stay tracked; the
# negations make that explicit should a broader `runs/` rule ever be added above.
!ucs/uc01_personalization/snapshots/runs/
!ucs/uc02_pseudonymization/eval/runs/

