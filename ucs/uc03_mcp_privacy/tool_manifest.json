    "create_note": {
      "payload": {
        "description": "File a note on a contact.\n\n        category is one of complaint, support, sales, follow_up, delivery,\n        general; when omitted the server assigns one. Session tokens in content\n        are restored by the server before the note is stored, so write them\n        exactly as received. The note records its author and the audit sequence\n        number of this call. Returns note_id, contact_id, category, created_at.\n        ",
        "inputSchema": {
          "properties": {
            "category": {
              "anyOf": [
                {
                  "type": "string"
                },
