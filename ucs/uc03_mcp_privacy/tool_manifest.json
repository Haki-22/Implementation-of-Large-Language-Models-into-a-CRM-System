    "search_contacts": {
      "payload": {
        "description": "Find CRM contacts.\n\n        Start here for a name or PERSON token: pass the whole token as query,\n        never its numeric part. Tokens are resolved locally before matching.\n        Every query word must match first name, last name, e-mail, phone, city\n        or employer; partial and Czech declined names are supported. company\n        narrows by employer. Returns id, name, company_id, company, city,\n        lifecycle_stage, note_count and last_order_date per candidate.\n        A surname and matching full names may have different PERSON tokens;\n        random token numbers do not indicate whether names match. Ask the user\n        to choose among multiple candidates. Pass the returned id (CONTACT\n        handle when masked) to subsequent contact tools. Preserve tokens exactly.\n        ",
        "inputSchema": {
          "properties": {
            "company": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Company"
            },
            "limit": {
              "default": 10,
              "title": "Limit",
              "type": "integer"
            },
            "query": {
              "title": "Query",
              "type": "string"
            }
          },
          "required": [
            "query"
          ],
          "title": "search_contactsArguments",
          "type": "object"
        },
        "name": "search_contacts",
        "outputSchema": {
          "additionalProperties": true,
          "title": "search_contactsDictOutput",
          "type": "object"
        }
      },
      "sha256": "18c20069d8b051a8af253477dc20189161f9d06a269d84be5e3562b95b2a93b5"
    },
